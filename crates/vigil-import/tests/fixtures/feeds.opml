      <outline text="Nested">
        <outline type="rss" text="Deep" xmlUrl="https://deep.example/rss"/>
      </outline>
    </outline>
    <outline type="rss" text="Loose" xmlUrl="https://loose.example/rss?key=SECRET"/>
    <outline text="A page" url="https://page.example/news"/>
    <outline type="rss" text="Gopher" xmlUrl="gopher://old.example/feed"/>
    <outline text="Empty folder"/>
  </body>
</opml>
