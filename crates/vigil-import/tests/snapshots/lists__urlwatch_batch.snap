---
source: crates/vigil-import/tests/lists.rs
expression: plan.batch
---
ImportBatch {
    tags: [
        ImportTag {
            name: "shops",
            default_interval_secs: None,
            target_urls: [],
        },
        ImportTag {
            name: "price watch",
            default_interval_secs: None,
            target_urls: [],
        },
    ],
    targets: [],
    watches: [
        ImportWatch {
            settings: NewWatch {
                name: "Widget price",
                url: "https://shop.example/widget?ref=SECRET",
                fetch: FetchSettings {
                    timeout_secs: None,
                    user_agent: None,
                    headers: {},
                    method: Get,
                    body: None,
                },
                schedule: Interval(
                    3600,
                ),
                jitter_secs: 0,
                processor: Text,
                pipeline: [
                    Css {
                        selector: "#price",
                        mode: Include,
                        required: false,
                    },
                    Css {
                        selector: ".old-price",
                        mode: Remove,
                        required: false,
                    },
                    Trim,
                ],
                conditions: Conditions {
                    trigger_text: [],
                    block_text: [],
                    notify_on: NotifyOn {
                        added: true,
                        removed: true,
                        changed: true,
                    },
                    scope: Added,
                },
                snapshot_retention: 100,
            },
            paused: false,
            tags: [
                "shops",
                "price watch",
            ],
            target_urls: [],
            template: None,
        },
        ImportWatch {
            settings: NewWatch {
                name: "News headlines",
                url: "https://news.example/",
                fetch: FetchSettings {
                    timeout_secs: None,
                    user_agent: None,
                    headers: {},
                    method: Get,
                    body: None,
                },
                schedule: Interval(
                    3600,
                ),
                jitter_secs: 0,
                processor: Text,
                pipeline: [
                    Css {
                        selector: "#headlines",
                        mode: Include,
                        required: false,
                    },
                    Unique,
                ],
                conditions: Conditions {
                    trigger_text: [],
                    block_text: [],
                    notify_on: NotifyOn {
                        added: true,
                        removed: true,
                        changed: true,
                    },
                    scope: Added,
                },
                snapshot_retention: 100,
            },
            paused: false,
            tags: [],
            target_urls: [],
            template: None,
        },
        ImportWatch {
            settings: NewWatch {
                name: "Search API",
                url: "https://api.example/search",
                fetch: FetchSettings {
                    timeout_secs: Some(
                        20,
                    ),
                    user_agent: None,
                    headers: {
                        "Content-Type": "application/x-www-form-urlencoded",
                        "Cookie": "session=SECRETCOOKIE",
                        "X-Token": "SECRETTOKEN",
                    },
                    method: Post,
                    body: Some(
                        "page=2&q=blue+widgets",
                    ),
                },
                schedule: Interval(
                    3600,
                ),
                jitter_secs: 0,
                processor: Json,
                pipeline: [
                    Jq {
                        program: ".items[].title",
                        raw: false,
                    },
                ],
                conditions: Conditions {
                    trigger_text: [],
                    block_text: [],
                    notify_on: NotifyOn {
                        added: true,
                        removed: true,
                        changed: true,
                    },
                    scope: Added,
                },
                snapshot_retention: 100,
            },
            paused: false,
            tags: [],
            target_urls: [],
            template: None,
        },
        ImportWatch {
            settings: NewWatch {
                name: "Stock JSON",
                url: "https://api.example/stock",
                fetch: FetchSettings {
                    timeout_secs: None,
                    user_agent: None,
                    headers: {
                        "Content-Type": "application/json",
                    },
                    method: Post,
                    body: Some(
                        "{\"sku\": 7}",
                    ),
                },
                schedule: Interval(
                    3600,
                ),
                jitter_secs: 0,
                processor: Text,
                pipeline: [
                    RegexExtract {
                        pattern: "(?m)^.*(?:in stock).*$",
                        group: 0,
                        required: false,
                    },
                    RegexReplace {
                        pattern: "(\\d+) left",
                        replacement: "${1} remaining",
                    },
                ],
                conditions: Conditions {
                    trigger_text: [],
                    block_text: [],
                    notify_on: NotifyOn {
                        added: true,
                        removed: true,
                        changed: true,
                    },
                    scope: Added,
                },
                snapshot_retention: 100,
            },
            paused: true,
            tags: [],
            target_urls: [],
            template: None,
        },
    ],
    allow_duplicates: false,
}
