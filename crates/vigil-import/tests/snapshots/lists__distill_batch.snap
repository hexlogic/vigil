---
source: crates/vigil-import/tests/lists.rs
expression: plan.batch
---
ImportBatch {
    tags: [
        ImportTag {
            name: "shops",
            default_interval_secs: None,
            target_urls: [],
        },
        ImportTag {
            name: "price",
            default_interval_secs: None,
            target_urls: [],
        },
    ],
    targets: [],
    watches: [
        ImportWatch {
            settings: NewWatch {
                name: "Widget",
                url: "https://shop.example/widget?utm=SECRET",
                fetch: FetchSettings {
                    timeout_secs: None,
                    user_agent: None,
                    headers: {},
                    method: Get,
                    body: None,
                },
                schedule: Interval(
                    3600,
                ),
                jitter_secs: 0,
                processor: Text,
                pipeline: [
                    Css {
                        selector: "#price, .stock",
                        mode: Include,
                        required: false,
                    },
                    Css {
                        selector: ".ad",
                        mode: Remove,
                        required: false,
                    },
                ],
                conditions: Conditions {
                    trigger_text: [],
                    block_text: [],
                    notify_on: NotifyOn {
                        added: true,
                        removed: true,
                        changed: true,
                    },
                    scope: Added,
                },
                snapshot_retention: 100,
            },
            paused: false,
            tags: [
                "shops",
                "price",
            ],
            target_urls: [],
            template: None,
        },
        ImportWatch {
            settings: NewWatch {
                name: "News",
                url: "https://news.example/",
                fetch: FetchSettings {
                    timeout_secs: None,
                    user_agent: None,
                    headers: {},
                    method: Get,
                    body: None,
                },
                schedule: Interval(
                    3600,
                ),
                jitter_secs: 0,
                processor: Text,
                pipeline: [
                    XPath {
                        expr: "//h1",
                        mode: Include,
                        required: false,
                    },
                ],
                conditions: Conditions {
                    trigger_text: [],
                    block_text: [],
                    notify_on: NotifyOn {
                        added: true,
                        removed: true,
                        changed: true,
                    },
                    scope: Added,
                },
                snapshot_retention: 100,
            },
            paused: false,
            tags: [],
            target_urls: [],
            template: None,
        },
        ImportWatch {
            settings: NewWatch {
                name: "https://plain.example/",
                url: "https://plain.example/",
                fetch: FetchSettings {
                    timeout_secs: None,
                    user_agent: None,
                    headers: {},
                    method: Get,
                    body: None,
                },
                schedule: Interval(
                    3600,
                ),
                jitter_secs: 0,
                processor: Text,
                pipeline: [],
                conditions: Conditions {
                    trigger_text: [],
                    block_text: [],
                    notify_on: NotifyOn {
                        added: true,
